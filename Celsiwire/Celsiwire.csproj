<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Debug keeps the console window for diagnostics; Release hides it (everything is also in the log file). -->
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(Configuration)' == 'Release'">WinExe</OutputType>
    <!-- .NET Framework 4.0 (Celsiwire.exe) and 3.5 (Celsiwire35.exe): SerialPort is part of System.dll, no NuGet package needed. -->
    <TargetFrameworks>net40;net35</TargetFrameworks>
    <LangVersion>7.0</LangVersion>
    <RootNamespace>Program</RootNamespace>
    <AssemblyName>Celsiwire</AssemblyName>
    <!-- .NET 3.5 build (e.g. Windows Server 2008 R2 without .NET 4) gets its own exe name. -->
    <AssemblyName Condition="'$(TargetFramework)' == 'net35'">Celsiwire35</AssemblyName>
    <Product>Celsiwire</Product>
    <AssemblyTitle>Celsiwire</AssemblyTitle>
    <!-- Application version: About tab, log, file properties. Keep app.manifest assemblyIdentity in sync. -->
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icons\Celsiwire.ico</ApplicationIcon>
    <!-- Code analysis on every build; noisy rules are tuned in ../.editorconfig. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="icons\Celsiwire.ico" LogicalName="Celsiwire.ico" />
    <EmbeddedResource Include="icons\Celsiwire-running.ico" LogicalName="Celsiwire-running.ico" />
    <EmbeddedResource Include="icons\Celsiwire-alarm.ico" LogicalName="Celsiwire-alarm.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- System, System.Data, System.Drawing and System.Xml are referenced implicitly by the SDK for .NET Framework. -->
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net35'">
    <!-- Build-time reference assemblies for .NET 3.5; nothing is added to the exe. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
